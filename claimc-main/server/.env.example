# ClaimChain API server configuration
# Copy to .env and adjust. Never commit real keys.

# Port for the API (0/empty is treated as unset -> 4000)
PORT=4000

# CORS origin allowed by the API
CORS_ORIGIN=http://localhost:5173

# ---- Chain connection ----
# Local Hardhat node (default)
RPC_URL=http://127.0.0.1:8545

# Contract address. Defaults to blockchain/deployments/localhost.json, then the
# well-known first-deployment address. Override after deploying elsewhere.
# CONTRACT_ADDRESS=0x...

# Sealing key — MUST be the contract owner (deployer). For the LOCAL node this
# is the well-known account #0 of `npx hardhat node` (safe to use, test funds only):
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- Evidence policy ----
# STRICT_NO_EXIF=1 makes missing EXIF a hard FAIL in stage 1 (camera-original
# evidence required). Default off: missing EXIF only warns, because many
# budget phones and messaging apps strip metadata on genuine claims.
# STRICT_NO_EXIF=1

# ---- Rate limiting (abuse defense) ----
# Global /api cap per window; intake (POST /api/claims) has its own stricter cap.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_INTAKE_MAX=12

# ---- Persistence (write-through claim snapshots) ----
# Set CLAIMCHAIN_PERSIST=0 for pure in-memory (old behavior). Snapshot lives at
# $DATA_DIR/claims.json (.data/ by default).
# CLAIMCHAIN_PERSIST=1
# DATA_DIR=.data

# ---- Polygon Amoy testnet (when going public) ----
# RPC_URL=https://rpc-amoy.polygon.technology
# PRIVATE_KEY=<your funded testnet key — keep out of git>
